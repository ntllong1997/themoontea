# Copy to .env.local and fill in. See README.md "Environment variables" for
# which of these are required vs. optional, and what each one is for.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_INVENTORY_WEBHOOK_URL=

# Cash App link shown to customers on /order/online.
NEXT_PUBLIC_CASHAPP_URL=https://cash.app/$TheMoonTea

# Square (customer card payments on /order/online — separate from the iPad's
# in-person reader, which is configured in MoonTea/MoonTea/Config/Secrets.swift).
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENV=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production

# Order-ready notifications (SMS or WhatsApp) sent after checkout.
NOTIFY_CHANNEL=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
