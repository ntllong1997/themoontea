import Foundation

enum Secrets {
    static let supabaseURL: String = "https://YOUR-PROJECT-REF.supabase.co"
    static let supabaseAnonKey: String = "YOUR-SUPABASE-ANON-KEY"

    // The staff database login (scripts/create-staff-user.mjs in the web repo).
    // Required lines — leave the placeholders to keep using the anon key, which
    // stops working once orders are locked down to staff.
    static let staffEmail: String = "YOUR-STAFF-EMAIL"
    static let staffPassword: String = "YOUR-STAFF-PASSWORD"

    static let squareApplicationID: String = "YOUR-SQUARE-APPLICATION-ID"
    static let squareLocationID: String    = "YOUR-SQUARE-LOCATION-ID"
    static let squareAccessToken: String   = "YOUR-SQUARE-ACCESS-TOKEN"
}
