import Foundation

enum Secrets {
    static let supabaseURL: String = "https://YOUR-PROJECT-REF.supabase.co"
    static let supabaseAnonKey: String = "YOUR-SUPABASE-ANON-KEY"

    static let squareApplicationID: String = "YOUR-SQUARE-APPLICATION-ID"
    static let squareLocationID: String    = "YOUR-SQUARE-LOCATION-ID"
    static let squareAccessToken: String   = "YOUR-SQUARE-ACCESS-TOKEN"

    // Sandbox credentials (Developer Console → toggle "Sandbox"). Debug builds
    // can switch to these in Reader Settings to test with MockReaderUI.
    static let squareSandboxApplicationID: String = "YOUR-SQUARE-SANDBOX-APPLICATION-ID"
    static let squareSandboxLocationID: String    = "YOUR-SQUARE-SANDBOX-LOCATION-ID"
    static let squareSandboxAccessToken: String   = "YOUR-SQUARE-SANDBOX-ACCESS-TOKEN"
}
